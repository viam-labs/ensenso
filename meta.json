{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "viam:ensenso",
  "visibility": "public_unlisted",
  "url": "https://github.com/viam-labs/ensenso",
  "description": "Viam module for IDS Ensenso 3D stereo cameras",
  "models": [
    {
      "api": "rdk:component:camera",
      "model": "viam:camera:ensenso"
    },
    {
      "api": "rdk:service:discovery",
      "model": "viam:ensenso:discovery"
    }
  ],
  "entrypoint": "viam-camera-ensenso",
  "first_run": "first_run.sh",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64"
    ]
  }
}
